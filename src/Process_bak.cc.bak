                {
//====================================Drift=====================================  
                    flag1=true;
                    xe_AfterDrift = gRandom->Gaus((*vi_vecXe)[ii],(4.68999e-03*sqrt(distance)));
                    ye_AfterDrift = gRandom->Gaus((*vi_vecYe)[ii],(4.69770e-03*sqrt(distance)));
                    GetRowColId(row,col,xe_AfterDrift,ye_AfterDrift,padsize,outerR);
                    //HitPadNumAfterDrift[row][col]++;
                    double efficiencyFactor = GetEfficiencyFactor(distance);
                    Map_PadNumAfterDrift[{row,col}] += 1/efficiencyFactor;
                    
                    EleNum++;
                    //int ran = gRandom->Gaus(2000,45);
                    int PoylaRandom = f1->GetRandom();

                    for(int j=0;j<PoylaRandom;++j)
                    {
                        xe_AfterAva = gRandom->Gaus(xe_AfterDrift, 0.012);
                        ye_AfterAva = gRandom->Gaus(ye_AfterDrift, 0.012);
                        GetRowColId(row,col,xe_AfterAva,ye_AfterAva,padsize,outerR);
                        
                        if(row>=padArray || col >=padArray)
                        {
                            continue;
                        }
                        //HitPadNumAfterAva[row][col]++;
                        Map_PadNumAfterAva[{row,col}]++;
                    }

                }
                
            }
            if(flag1)
            {
                clusNum++;
            }
        }
        double FindHitNum=0;
        // for(int i=0;i<padArray;i++){
