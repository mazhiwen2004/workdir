void GetRowColId(int &row_id,int &col_id,double xxe,double yye,double padsize,double outerR)
{
    int boxSide = outerR*2; //cm
    int nPadRows = boxSide/padsize;
    row_id = (int)floor(xxe/padsize)+nPadRows/2;
    col_id = (int)floor(yye/padsize)+nPadRows/2;
    if(row_id == nPadRows)
    {
        row_id = nPadRows-1;
    }
    if(col_id == nPadRows)
    {
        col_id = nPadRows-1;
    }
}

double GetEfficiencyFactor(double x_Distance)
{
    double y = 0.7021 + 0.006986*x_Distance - 3.068*1.0E-5*x_Distance*x_Distance + 5.56*1.0E-8*x_Distance*x_Distance*x_Distance;
    return y;
}

