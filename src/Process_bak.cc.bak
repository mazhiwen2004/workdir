            for(int ii=0;ii<vi_vecXe->size();++ii)
            {
                auto distance = fabs(235. - vi_vecZe->at(ii));
                if(sqrt(pow((*vi_vecXe)[ii], 2) + pow((*vi_vecYe)[ii], 2)) < (outerR-0.05)
                && sqrt(pow((*vi_vecXe)[ii], 2) + pow((*vi_vecYe)[ii], 2)) > (innerR+0.05)
